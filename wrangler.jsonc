{
  // Instellingen voor Cloudflare: serveer de bestanden in deze map als website
  "name": "website",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // worker.js stuurt het oude adres en www door naar waltermontenarie.com
  // en verstuurt de formulieren als e-mail (via Email Routing van Cloudflare)
  "main": "worker.js",
  "send_email": [
    { "name": "MAIL", "destination_address": "walter.montenarie@gmail.com" }
  ],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
